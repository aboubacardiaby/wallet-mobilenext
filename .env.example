# API Configuration
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

# Wave Payout Mock API (wave-payout-mock-api/) — local sandbox that mimics Wave's
# real payout API. Run with `dotnet run` from wave-payout-mock-api/ (default port 5250).
EXPO_PUBLIC_WAVE_API_URL=http://localhost:5250/v1/
EXPO_PUBLIC_WAVE_API_KEY=wave_mock_secret_key

# Stripe publishable key (client-side tokenization) — get from the Stripe dashboard
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Backend endpoint for sending the transfer receipt email (defaults to 'email/send')
EXPO_PUBLIC_RECEIPT_EMAIL_ENDPOINT=email/send

# Bank (ACH) top-ups (T034d). Both values appear in the bank-debit authorization the customer
# accepts, so they are legal content: counsel must approve the real name, terms and wording
# before production. The bank option stays disabled unless BOTH are set (https link required).
EXPO_PUBLIC_MANDATE_BUSINESS_NAME=
EXPO_PUBLIC_TERMS_URL=
