# API Configuration
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

# Wave Payout Mock API (wave-payout-mock-api/) — local sandbox that mimics Wave's
# real payout API. Run with `dotnet run` from wave-payout-mock-api/ (default port 5250).
EXPO_PUBLIC_WAVE_API_URL=http://localhost:5250/v1/
EXPO_PUBLIC_WAVE_API_KEY=wave_mock_secret_key

# Stripe publishable key (client-side tokenization) — get from the Stripe dashboard
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
